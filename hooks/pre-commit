#!/bin/sh
# Hook de pre-commit de forja-nodos.
# Anclaje: MANUAL_SISTEMA_DE_CONOCIMIENTO seccion 2: el gate de integridad se
# corre EN CADA COMMIT, y el hook de estilo de la casa prohibe los guiones
# largos y medios.
#
# En rojo, aborta el commit. No se salta: si falla, se corrige y se reintenta.
# Se instala con: bash hooks/install_hooks.sh

set -e

RAIZ=$(git rev-parse --show-toplevel)
cd "$RAIZ"

PYTHON=${FORJA_PYTHON:-python}
if ! command -v "$PYTHON" >/dev/null 2>&1; then
    PYTHON=python3
fi

echo "[pre-commit] gate de integridad"
if ! "$PYTHON" forja.py gate; then
    echo ""
    echo "[pre-commit] COMMIT ABORTADO: el gate esta en rojo."
    echo "Corrige los fallos de arriba. El hook no se salta (docs/loop/EJECUTOR.md, regla 10)."
    exit 1
fi

echo "[pre-commit] barrido de guiones"
if ! "$PYTHON" forja.py guiones; then
    echo ""
    echo "[pre-commit] COMMIT ABORTADO: hay guiones largos o medios en el repo."
    echo "Reemplazalos por el guion corto normal y vuelve a intentarlo."
    exit 1
fi

# LA TABLA QUE DICE SER DE INSTRUMENTO ES LA DEL INSTRUMENTO (D.41, 13 sep 2026).
# Solo lee ficheros ya escritos: no corre ningun instrumento. Cuesta menos de un
# segundo, y caza la especie que tumbo la racha REPORTE cuatro veces seguidas.
echo "[pre-commit] tallado del reporte (D.41) y censo de rutas (D.42)"
if ! "$PYTHON" scripts/cerrar_reporte.py --hook; then
    echo ""
    echo "[pre-commit] COMMIT ABORTADO: una tabla no coincide con su instrumento"
    echo "(D.41), o una ruta publicada como sede de una cifra no sostiene nada (D.42)."
    echo "Ninguna de las dos se corrige tecleando la celda buena."
    exit 1
fi

echo "[pre-commit] verde"
exit 0
